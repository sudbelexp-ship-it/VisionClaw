<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<!--
	  Объявляем приложение русскоязычным.

	  Это не косметика. Locale.current возвращает локаль, до которой разрешилось ПРИЛОЖЕНИЕ, и она
	  ограничена языками, которые приложение о себе заявляет. Пока здесь был только английский,
	  на русском телефоне Locale.current давал en-US — и распознавание речи послушно слушало
	  по-английски, записывая русские слова как английские. Интерфейс теперь русский, и система
	  об этом знает.
	-->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>en</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>VisionClaw</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>VisionClaw</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>cameraaccess</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.visionclaw.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>visionclaw</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- App uses only exempt encryption (standard TLS/HTTPS): skips the TestFlight export-compliance prompt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Begin required section for Device Access Toolkit Apps -->
	<!-- Meta Wearables Device Access Toolkit Setup -->
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<!-- Tell DAT your URL scheme so it can be called back from Meta AI -->
		<string>cameraaccess://</string>
		<key>MetaAppID</key>
		<!-- Without Developer Mode, this key will need to be set with ID from the app registered in Wearables Developer Center -->
		<string>$(META_APP_ID)</string>
		<!-- Without Developer Mode, this key will need to be set with ClientToken from the app registered in Wearables Developer Center -->
		<key>ClientToken</key>
		<string>$(CLIENT_TOKEN)</string>
		<!-- Without Developer Mode, this key will need to be set with your Apple Developer Team ID - Set this in Xcode under Signing & Capabilities -->
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Нужен для подключения к очкам Meta.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Позволяет телефону найти очки по Wi-Fi — по нему видео идёт заметно лучше, чем по Bluetooth.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bonjour._tcp</string>
	</array>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Нужен для звука с очков Meta.</string>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<!-- End required section for Device Access Toolkit Apps -->
	<key>NSCameraUsageDescription</key>
	<string>Камера телефона снимает кадр, когда очки не подключены или выбраны вручную.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Микрофон нужен для голосовых вопросов, синхронного перевода и фразы-триггера.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Распознавание речи превращает сказанное в текст: вопросы, команды и перевод собеседника.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Нужно, чтобы сохранять снимки с очков в вашу фотоплёнку.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Доступ к календарю, чтобы ассистент отвечал про расписание и создавал события по просьбе.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Доступ к напоминаниям, чтобы ассистент создавал их по вашей просьбе.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!--
		  GigaChat's hosts present a chain anchored to the Russian Ministry of Digital Development
		  root CA, which is not in Apple's system trust store. GigaChatTrustDelegate supplies that
		  root as an anchor and validates the chain itself, but a trust delegate alone is not
		  enough: ATS evaluates the connection independently and fails it before the delegate is
		  ever asked, which is exactly why the app reported a bare "A TLS error caused the secure
		  connection to fail" with no detail from our own SecTrust check. Apple's QA1948 states the
		  requirement directly: overriding NSURLSession's server trust evaluation additionally
		  requires disabling ATS for that server.

		  NSExceptionAllowsInsecureHTTPLoads is misleadingly named: it does not permit plain HTTP
		  here, it stops ATS from requiring a system-anchored chain and hands that decision to our
		  delegate. Everything else stays strict: TLS 1.2 minimum (the servers negotiate 1.3),
		  forward secrecy required, and the chain still has to match the pinned Минцифры anchors,
		  so this is scoped to Sber's hosts and narrows nothing else.
		-->
		<key>NSExceptionDomains</key>
		<dict>
			<key>devices.sberbank.ru</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
